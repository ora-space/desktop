{
  "name": "@ora/workflow-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./memory": "./src/memory.ts"
  },
  "scripts": {
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src tests --max-warnings 0",
    "test": "deno run -A ../../scripts/run-with-clean-stderr.ts \"vitest run\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@ora/workflow-mock": "workspace:*",
    "vitest": "4.1.10"
  }
}
