{
  "name": "@ora/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./composer": "./src/composer/index.ts"
  },
  "scripts": {
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src tests --max-warnings 0",
    "test": "deno run -A ../../scripts/run-with-clean-stderr.ts \"tsc -p tsconfig.json --noEmit && deno test --no-check -A tests/*.test.ts\""
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@tiptap/core": "3.30.1",
    "@tiptap/extension-bold": "3.30.1",
    "@tiptap/extension-code": "3.30.1",
    "@tiptap/extension-highlight": "3.30.1",
    "@tiptap/extension-horizontal-rule": "3.30.1",
    "@tiptap/extension-image": "3.30.1",
    "@tiptap/extension-italic": "3.30.1",
    "@tiptap/extension-link": "3.30.1",
    "@tiptap/extension-list": "3.30.1",
    "@tiptap/extension-strike": "3.30.1",
    "@tiptap/extension-subscript": "3.30.1",
    "@tiptap/extension-superscript": "3.30.1",
    "@tiptap/extension-text-align": "3.30.1",
    "@tiptap/extension-typography": "3.30.1",
    "@tiptap/extension-underline": "3.30.1",
    "@tiptap/extensions": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@tiptap/react": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "lodash": "4.18.1",
    "react-hotkeys-hook": "4.6.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/lodash": "4.17.25",
    "@types/react": "19.2.14"
  }
}
