    "@tabler/icons-react": "3.44.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "next-themes": "0.4.6",
    "react-day-picker": "10.0.1",
    "react-resizable-panels": "4.12.2",
    "recharts": "3.8.0",
    "shadcn": "4.13.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0"
  }
