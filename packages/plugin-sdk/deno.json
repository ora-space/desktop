{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@ora-space/plugin-sdk",
  "version": "0.1.3",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts"
  },
  "publish": {
    "include": [
      "README.md",
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "tests/**"
    ]
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "esnext"],
    "strict": true
  },
  "fmt": {
    "lineWidth": 80,
    "semiColons": true,
    "singleQuote": false
  }
}
