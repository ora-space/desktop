{
  "name": "@ora/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:error-schema": "ts-to-zod src/error.ts src/error.schema.ts",
    "clean:test": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\"",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src tests --max-warnings 0",
    "test": "node ../../scripts/run-with-clean-stderr.mjs \"node -e \\\"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\\\" && tsc -p tsconfig.json && node --test .test-dist/tests/*.test.js\""
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "react-diff-view": "^3.3.3",
    "ts-to-zod": "^5.1.0"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
