{
  "name": "ora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "deno": "2.9.5"
  },
  "scripts": {
    "prepare": "husky",
    "setup:binary": "deno run -A scripts/setup-binary.ts",
    "format:files": "prettier",
    "lint:commit": "commitlint",
    "check:tooling": "deno task check:toolchain && deno lint scripts && deno check scripts/*.ts",
    "test:tooling": "deno task check:tooling && deno test -A scripts/*.test.ts",
    "clean:frontend": "deno run --allow-read --allow-write scripts/clean-frontend.ts",
    "check:toolchain": "deno run --allow-read scripts/check-toolchain.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.1",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.4",
    "eslint": "10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2"
  }
}
