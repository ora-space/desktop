{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ora",
  "version": "0.1.0",
  "identifier": "space.ora.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ora",
        "width": 1280,
        "height": 832,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#fdfdfe"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["dmg", "app", "nsis", "appimage", "deb"],
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2NTdCMDc1RTU2NzczMTgKUldRWWMyZmxkYkJYRm1ic0UvdGZPb2I1S0tuQzFaVUd6dzNaNUc2MFRXak9icmQrVmJMR1RiN3AK",
      "endpoints": [
        "https://github.com/ora-space/desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
