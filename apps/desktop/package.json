{
  "name": "@ora/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"web/**/*.{ts,tsx,css}\" \"*.{html,json,ts}\" --ignore-path ../../.prettierignore",
    "format:check": "prettier --check \"web/**/*.{ts,tsx,css}\" \"*.{html,json,ts}\" --ignore-path ../../.prettierignore",
    "dev": "vite",
    "build": "node ../../scripts/setup-binary.mjs && tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "node ../../scripts/run-with-clean-stderr.mjs \"vitest run web/tauri-transport.test.ts web/tauri-platform-adapter.test.ts\"",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ora/app-shell": "workspace:*",
    "@ora/chat": "workspace:*",
    "@ora/contracts": "workspace:*",
    "@ora/ui": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tailwindcss/vite": "^4.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vitest": "^4.1.10",
    "vite": "^8.0.10"
  }
}
